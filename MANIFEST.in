prune venv*
prune .venv
prune env
include LICENSE
include lightdock/scoring/interface_array.h
include lightdock/etc/glowworm.conf
include lightdock/scoring/ddna/data/fort.21_xscore_noH_Met
include lightdock/scoring/tobia1/data/TOBI_A1_step*
include lightdock/scoring/tobia2/data/TOBI_A2_step*
include lightdock/scoring/tobibahar/data/*.dat
include lightdock/scoring/tobisc/data/*.dat
recursive-include lightdock *.pyx
include lightdock/test/etc/glowworm.conf
recursive-include lightdock/test/post/golden_data *
include lightdock/scoring/dfire/data/DCparams
include lightdock/scoring/fastdfire/data/DCparams
include lightdock/scoring/pisa/data/pisa.params
include lightdock/scoring/dfire2/data/dfire2_energies.npy
include lightdock/scoring/dfire2/data/dfire_pair.lib
include lightdock/scoring/mj3h/data/MJ_potentials.dat
recursive-include lightdock/test/prep/golden_data *
recursive-include lightdock/test/gso/searchspace/golden_data *
recursive-include lightdock/test/gso/golden_data *
recursive-include lightdock/test/util/golden_data *
recursive-include lightdock/test/bin/post/golden_data *
recursive-include lightdock/test/bin/golden_data *
recursive-include lightdock/test/pdbutil/golden_data *
recursive-include lightdock/test/scoring/golden_data *
recursive-include lightdock/test/structure/golden_data *
recursive-include lightdock/test/mathutil/golden_data *
